library(chromote)
library(rvest)
b <- ChromoteSession$new()
b$Page$navigate("https://www.myschool.edu.au/school/48431")
b$Page$loadEventFired()  # wait for page load
# Click Accept (if visible)
b$Runtime$evaluate("document.querySelector('button.btn-accept')?.click()")
Sys.sleep(2)
# Get HTML after JS has run
html <- b$Runtime$evaluate("document.documentElement.outerHTML")$result$value
page <- read_html(html)
# Now `page` is ready for scraping
school_name <- page %>% html_element("h1") %>% html_text(trim = TRUE)
print(school_name)
school_name
library(chromote)
library(rvest)
b <- ChromoteSession$new()
# Step 1: Load root page to set up JS context
b$Page$navigate("https://www.myschool.edu.au")
b$Page$loadEventFired()
Sys.sleep(2)
# Step 2: Simulate checkbox tick and form submit
b$Runtime$evaluate('document.querySelector("#checkBoxTou").checked = true;')
b$Runtime$evaluate('document.querySelector("#acceptButton").disabled = false;')
b$Runtime$evaluate('document.querySelector("#terms-form").submit();')
Sys.sleep(2)
# Step 3: Navigate to actual school page
b$Page$navigate("https://www.myschool.edu.au/school/48431")
b$Page$loadEventFired()
Sys.sleep(2)
# Step 4: Read HTML after modal bypass
html <- b$Runtime$evaluate("document.documentElement.outerHTML")$result$value
page <- read_html(html)
# Step 5: Extract
school_name <- page %>% html_element("h1") %>% html_text(trim = TRUE)
print(school_name)
library(chromote)
library(rvest)
b <- ChromoteSession$new()
# Load root domain
b$Page$navigate("https://www.myschool.edu.au")
b$Page$loadEventFired()
Sys.sleep(2)
# ✅ Set localStorage.acceptedTerms flag
b$Runtime$evaluate('localStorage.setItem("acceptedTerms", "true");')
Sys.sleep(1)
# 🔁 Reload the current frame to apply localStorage
b$Page$reload()
b$Page$loadEventFired()
Sys.sleep(1)
# Now navigate to the school page
b$Page$navigate("https://www.myschool.edu.au/school/48431")
b$Page$loadEventFired()
Sys.sleep(2)
# Extract HTML
html <- b$Runtime$evaluate("document.documentElement.outerHTML")$result$value
page <- read_html(html)
# Check
school_name <- page %>% html_element("h1") %>% html_text(trim = TRUE)
print(school_name)
