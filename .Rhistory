time_vals <- time(region9)
time_index <- as.yearmon(time_vals)
monthly_means <- tapp(region9, time_index, fun = mean, na.rm = TRUE)
time_seq <- seq_len(nlyr(monthly_means))
compute_trend <- function(values) {
if (all(is.na(values))) return(NA)  # Handle missing values
lm_fit <- lm(values ~ time_seq)  # Fit linear model
return(coef(lm_fit)[2])  # Return slope
}
trend_sst <- app(monthly_means, fun = compute_trend)
