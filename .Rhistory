library(chromote)
library(rvest)
b <- ChromoteSession$new()
# Step 1: Navigate to base domain to inject localStorage
b$Page$navigate("https://www.myschool.edu.au")
b$Page$loadEventFired()
Sys.sleep(2)
# ✅ Step 2: Set acceptance flag directly
b$Runtime$evaluate('localStorage.setItem("acceptedTerms", "true");')
Sys.sleep(1)
# ✅ Step 3: Reload page to apply localStorage effect
b$Page$reload()
b$Page$loadEventFired()
Sys.sleep(1)
# ✅ Step 4: Navigate directly to school page
b$Page$navigate("https://www.myschool.edu.au/school/48431")
b$Page$loadEventFired()
Sys.sleep(3)
# ✅ Step 5: Poll until Year 5 table appears
repeat {
found <- b$Runtime$evaluate('document.querySelector("table[summary*=\'Year 5\']") !== null')$result$value
if (found) break
Sys.sleep(0.5)
}
library(chromote)
library(rvest)
b <- ChromoteSession$new()
# Accept terms via localStorage
b$Page$navigate("https://www.myschool.edu.au")
b$Page$loadEventFired()
Sys.sleep(2)
b$Runtime$evaluate('localStorage.setItem("acceptedTerms", "true");')
b$Page$reload()
b$Page$loadEventFired()
Sys.sleep(1)
# Navigate directly to NAPLAN results page
b$Page$navigate("https://www.myschool.edu.au/school/48431/naplan/results")
b$Page$loadEventFired()
Sys.sleep(3)
# Pull all script tags
scripts <- b$Runtime$evaluate('Array.from(document.scripts).map(s => s.innerText)')$result$value
# Find the one with "createChartnaplanGraphs"
naplan_script <- scripts[grep("createChartnaplanGraphs", scripts)][[1]]
cat(substr(naplan_script, 1, 1000))  # preview first 1000 chars
naplan_script
