library(tidyverse)
df <- data.frame(
max_dhw = maximum_dhw |> as.data.frame(),
variance = trend_sst |> as.data.frame()
) |>
rename(max_dhw = 1, variance = 2) |>
mutate(
category = case_when(
max_dhw > 2 & variance > 0 ~ "High DHW & High Variance",
max_dhw > 2 & variance <= 0 ~ "High DHW & Low Variance",
max_dhw <= 2 & variance > 0 ~ "Low DHW & High Variance",
TRUE ~ "Low DHW & Low Variance"
)
)
ggplot(df, aes(x = max_dhw, y = variance, color = category)) +
geom_point() +
geom_hline(yintercept = 0, linetype = "dashed") +
geom_vline(xintercept = 2, linetype = "dashed") +
theme_bw() +
scale_color_manual(values = c(
"High DHW & High Variance" = "#D7191C",
"High DHW & Low Variance" = "#FDAE61",
"Low DHW & High Variance" = "#ABDDA4",
"Low DHW & Low Variance" = "#2B83BA"
))
ggplot(df, aes(x = max_dhw, y = variance, color = category)) +
geom_point(shape=21, size=3) +
