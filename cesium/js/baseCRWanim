  const viewer = new Cesium.Viewer('cesiumContainer', {
      timeline: true,
      animation: true,
      baseLayerPicker: false,
      homeButton: false,
      sceneModePicker: false,
      navigationHelpButton: false,
      infoBox: false,
      geocoder: false
    });


    viewer.scene.skyBox.show = false;
    viewer.scene.sun.show = false;
    viewer.scene.moon.show = false;
    viewer.scene.skyAtmosphere.show = false;
    viewer._cesiumWidget._creditContainer.style.display = "none";

    const start = Cesium.JulianDate.fromIso8601("2024-01-01T00:00:00Z");
    const stop = Cesium.JulianDate.fromIso8601("2024-01-10T00:00:00Z");

    viewer.clock.startTime = start.clone();
    viewer.clock.stopTime = stop.clone();
    viewer.clock.currentTime = start.clone();
    viewer.clock.clockRange = Cesium.ClockRange.LOOP_STOP;
    viewer.clock.multiplier = 86400*2; // 1 day per tick
    viewer.timeline.zoomTo(start, stop);

    const imageryLayers = {};
    const dates = [];

    for (let i = 0; i < 10; i++) {
      const date = new Date(Date.UTC(2024, 0, 1 + i));
      const ymd = date.toISOString().split("T")[0].replace(/-/g, "");
      dates.push(ymd);

      const layer = viewer.imageryLayers.addImageryProvider(
        new Cesium.UrlTemplateImageryProvider({
          url: `https://storage.googleapis.com/production-coral-tiles/crw/dhw/${ymd}/{z}/{x}/{y}.png`
        })
      );
      layer.alpha = 0.0;
      imageryLayers[ymd] = layer;
    }

    viewer.clock.onTick.addEventListener(() => {
      const current = Cesium.JulianDate.toDate(viewer.clock.currentTime);
      const ymd = current.toISOString().split("T")[0].replace(/-/g, "");
      Object.entries(imageryLayers).forEach(([key, layer]) => {
        layer.alpha = (key === ymd) ? 1.0 : 0.0;
      });
    });

    viewer.camera.setView({
      destination: Cesium.Cartesian3.fromDegrees(136, -17, 12000000),
      orientation: {
        heading: 0,
        pitch: -Math.PI / 1.98,
        roll: 0.05
      }
    });